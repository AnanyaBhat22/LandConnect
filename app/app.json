{
  "expo": {
    "name": "LandConnect",
    "slug": "landconnect",
    "scheme": "landconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.landconnect.prototype",
      "bitcode": false
    },
    "android": {
      "package": "com.landconnect.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#167A5B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "LandConnect uses the camera for video calls.",
          "microphonePermission": "LandConnect uses the microphone for audio and video calls."
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "@maplibre/maplibre-react-native",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12251E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 150
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5123f223-e6d2-4baf-95c4-5e868130415d"
      }
    },
    "owner": "meadowmaven"
  }
}
